[household]
settingsTitle = {$name} Settings
backToHousehold = Back to Household
members = Members ({$count :integer})
makeOwner = Make owner
makeOwnerConfirm = Make {$name} an owner? Owners manage members, invites, and settings, and this frees you to leave the household.
removeMember = Remove member
leave = Leave Household
leaveConfirm = Leave this household? You'll lose access to its recipes, pantry, and lists, and will need an invite or a new household to keep using Foodex.
leaveNeedOwner = Make another member an owner before leaving, or delete the household.
movingOutHint = Moving out? Make another member an owner first, then you can leave.
leavingHint = Leaving?
packBox = Pack a moving box
packBoxRest = to take recipes with you.
inviteLink = Invite Link
inviteHelp = Share a link so others can join. Links expire after 7 days.
revoke = Revoke
generateInvite = Generate Invite Link
householdName = Household Name
dangerZone = Danger Zone
deleteHousehold = Delete Household
deleteConfirm = Delete this household? This cannot be undone.
getStarted = Get Started
getStartedBlurb = Create a new household or join an existing one to manage recipes, tools, stores, and your pantry.
getStartedInviteOnly = Foodex is invite-only. Join a household with the invite code or link you received; if you don't have one, ask a household member or an operator for an invite.
createHousehold = Create Household
joinHousehold = Join Household
inviteCode = Invite Code
