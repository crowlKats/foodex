inviteOnlyCreate = Foodex is invite-only; households can't be created directly.
nameRequired = Name is required
joinOrCreateTitle = Join or Create Household
owner = owner
member = member
boxWillUnpack =
  .input {$count :integer}
  .match $count
  one {{Your moving box with {$count} recipe will unpack into the household you join or create.}}
  * {{Your moving box with {$count} recipes will unpack into the household you join or create.}}
movingBoxLink = moving box

[empty]
noTools = No tools yet
noToolsMatch = No tools match "{$query}"
noToolsBody = Tools are your cookware: a pan, a stand mixer, an oven. A recipe can reference one along with the settings it needs ("180 °C", "medium-low") and a note on how it's used.
noIngredients = No ingredients yet
noIngredientsMatch = No ingredients match "{$query}"
noIngredientsBody = Ingredients are the shared catalog that recipes, your pantry and the shopping list all point at. Linking a recipe line to one is what lets Foodex track stock, prices and substitutions.
noIngredientsMatchBody = Nothing in the catalog goes by that name. Try a shorter search, or add it below.
noStores = No stores yet
noStoresMatch = No stores match "{$query}"
noStoresBody = Stores are the shops you buy from. Recording one lets you attach prices to ingredients, which is what puts a running total on the shopping list and lets it group your list by shop.
signInToAdd = Sign in to add one.
addFirstForm = Add your first with the form on this page.
addIngredientFirst = Use the Add Ingredient form to create the first one.
noCollections = No collections yet
noCollectionsMatch = No collections match "{$query}"
noCollectionsBody = Group recipes into a weeknight set, a holiday menu, or whatever else you cook from. Collections can be shared with other households.
noConversations = No conversations yet
noConversationsMatch = No conversations match "{$query}"
noRecipes = No recipes yet
noRecipesBody = Write one from scratch, or import one from a URL, a photo or a block of text.
noRecipesMatch = No recipes match "{$query}"
noRecipesMatchBody = Try a shorter search.
noRecipesMatchBodyFilters = Try a shorter search, or clear the filters.
noRecipesFilters = No recipes match these filters
noRecipesFiltersBody = Nothing in the collection fits every filter you've picked.
nothingReady = Nothing is ready to make yet
nothingReadyBody = "Ready to make" only shows recipes your pantry already covers, and your pantry is empty.
stockPantry = Stock the pantry
showAllRecipes = Show all recipes
clearAllFilters = Clear all filters
newRecipe = New recipe
betweenHouseholds = You're between households
betweenHouseholdsPacked = Join or create a household and the box unpacks there.
betweenHouseholdsEmpty = There's nothing packed. If you left a household without packing, ask a remaining member to share what you need.

