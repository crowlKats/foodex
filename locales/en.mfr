continueGoogle = Continue with Google
continueAuthentik = Continue with Authentik
continueEmail = Continue with email
emailPlaceholder = Email address
captchaFailed = Captcha verification failed. Please try again.
inviteRequired = New accounts on this Foodex instance can only be created through an invite link. If someone invited you, open their invite link and sign in from there.
checkEmailTitle = Check Your Email
checkEmailHeading = Check your email
checkEmailBody = We've sent a sign-in link to that address. Follow it to sign in, or to create your account if this is your first time here. The link expires in 15 minutes.
backToSignIn = Back to sign in
invalidLinkTitle = Invalid Link
invalidLinkHeading = Invalid or expired link
invalidLinkBody = This sign-in link has expired or has already been used. Please request a new one.
inviteRequiredTitle = Invite Required
inviteRequiredHeading = Invite required

[profile]
title = Profile
displayName = Display Name
displayNameHelp = Shown to other members of your household.
preferences = Preferences
unitSystem = Unit system
metric = Metric (g, ml, cm)
imperial = Imperial (oz, fl oz, inch)
household = Household
language = Language
languageHelp = The language used for buttons, labels, and the rest of the Foodex chrome. Recipes stay in English.
signOut = Sign out

[language]
en = English
it = Italiano

[welcome]
title = Welcome
heading = Welcome to Foodex
blurb = One quick thing before you get cooking: what should we call you?
nameLabel = Your name
namePlaceholder = How your household sees you
tourIntro = A one-minute tour of what's what.
getStarted = Get started
tourRecipesTitle = Recipes
tourRecipesBody = The shared cookbook. Browse and cook what every household has added, and add your own: import recipes from photos, web pages, or pasted text instead of typing them.
tourCollectionsTitle = Collections
tourCollectionsBody = Group recipes however you like: a weeknight set, a holiday menu, everything from one book. Collections can be shared with other households by link.
tourCollectionsFallback = On a phone, Collections lives in this menu.
tourAssistantTitle = Assistant
tourAssistantBody = A chat that helps with the tedious parts: finding, importing, and reworking recipes. Everything it proposes is staged for your review before it touches anything.
tourAssistantFallback = On a phone, the Assistant lives in this menu.
tourPantryTitle = Pantry
tourPantryBody = What's in your kitchen. The pantry powers the "ready to make" filter, tells recipes what you already have, and warns you before things expire.
tourScanTitle = Scan
tourScanBody = The barcode scanner. Point your camera at your groceries as you unpack them and they land in the pantry, with the name and package size filled in for you.
tourPlanTitle = Plan
tourPlanBody = What you intend to cook. Planning a meal puts its missing ingredients on the shopping list, and cooking it updates the pantry.
tourShoppingTitle = Shopping List
tourShoppingBody = Worked out for you: whatever your plan needs that the pantry can't cover. Tick items off as you buy them and they land straight in the pantry.
tourCatalogsTitle = Ingredients, Stores & Tools
tourCatalogsBody = Shared reference catalogs. Record what things cost where, and which kitchen tools you own; that's what powers cost estimates and the "ready to make" filter.
tourCatalogsFallback = On a phone, these catalogs live in this menu.
tourDocsTitle = The Guide
tourDocsBody = Full documentation for everything you just saw, whenever you need the details.
tourDocsFallback = On a phone, the guide lives in this menu.
tourHouseholdTitle = Your Household
tourHouseholdBody = The people you cook with: members, invites, and settings. Everything you've just seen is shared with them. Next up: create your household or join one with an invite.

[error]
notFoundTitle = We couldn't find that page
notFoundBody = Nothing lives at this address. The link may be out of date, or the recipe may have been renamed or deleted.
serverTitle = Something went wrong
serverBody = The page failed to load. Trying again often works; if it doesn't, the problem is on our side.
browseRecipes = Browse recipes
needHousehold = Join or create a household to do this.
generic = Something went wrong. Please try again.
noMatchQuery = Nothing here goes by that name.

[sudo]
banner = Sudo: acting as {$name}. Changes are recorded under {$admin}'s name.
exit = Exit sudo

