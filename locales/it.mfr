# Foodex UI chrome, Italian. Missing keys fall back to English at runtime.
@locale it
---

[nav]
recipes = Ricette
collections = Collezioni
assistant = Assistente
pantry = Dispensa
plan = Piano
shoppingList = Lista della spesa
shop = Spesa
ingredients = Ingredienti
stores = Negozi
tools = Attrezzi
admin = Amministrazione
docs = Guida
household = Nucleo
signIn = Accedi
signOut = Esci
menu = Menu
scan = Scansiona

[common]
save = Salva
cancel = Annulla
delete = Elimina
edit = Modifica
update = Aggiorna
create = Crea
back = Indietro
continue = Continua
search = Cerca
share = Condividi
copied = Copiato!
close = Chiudi
dismiss = Chiudi
or = oppure
you = (tu)
home = Home
shared = Condiviso
owned = in possesso
expired = scaduto
allCount = Tutti {$title} ({$count})
apply = Applica
invite = Invita
from = Da
to = A
type = Tipo
source = Fonte
prev = Prec
next = Succ
skip = Salta
backTo = Indietro
name = Nome
email = Email
required = Obbligatorio
loading = Caricamento…
error = Errore
remove = Rimuovi
add = Aggiungi
import = Importa
new = Nuovo
settings = Impostazioni
searchPlaceholder = Cerca {$title}...
pageOf =
  .input {$current :integer}
  .input {$total :integer}
  .match $current
  * {{Pagina {$current} di {$total}}}
descending = Decrescente
ascending = Crescente
totalCount =
  .input {$count :integer}
  .match $count
  one {{{$count} in totale}}
  * {{{$count} in totale}}
noName = (senza nome)
noEmail = nessuna email
darkMode = Attiva/disattiva tema scuro

[auth]
signInTitle = Accedi
signInHeading = Accedi a Foodex
continueGithub = Continua con GitHub
continueGoogle = Continua con Google
continueAuthentik = Continua con Authentik
continueEmail = Continua con l'email
emailPlaceholder = Indirizzo email
captchaFailed = Verifica captcha non riuscita. Riprova.
inviteRequired = Su questa installazione di Foodex i nuovi account si creano solo con un invito. Se qualcuno ti ha invitato, apri il suo link e accedi da lì.
checkEmailTitle = Controlla la tua email
checkEmailHeading = Controlla la tua email
checkEmailBody = Abbiamo inviato un link di accesso a quell'indirizzo. Seguilo per accedere, o per creare l'account se è la prima volta. Il link scade tra 15 minuti.
backToSignIn = Torna all'accesso
invalidLinkTitle = Link non valido
invalidLinkHeading = Link non valido o scaduto
invalidLinkBody = Questo link di accesso è scaduto o è già stato usato. Richiedine uno nuovo.
inviteRequiredTitle = Invito necessario
inviteRequiredHeading = Invito necessario

[profile]
title = Profilo
displayName = Nome visualizzato
displayNameHelp = Visibile agli altri membri del tuo nucleo.
preferences = Preferenze
unitSystem = Sistema di unità
metric = Metriche (g, ml, cm)
imperial = Imperiali (oz, fl oz, inch)
household = Nucleo
language = Lingua
languageHelp = La lingua di pulsanti, etichette e del resto dell'interfaccia. Le ricette restano in inglese.
signOut = Esci

[language]
en = English
it = Italiano

[welcome]
title = Benvenuto
heading = Benvenuto su Foodex
blurb = Una cosa sola prima di cucinare: come ti chiamiamo?
nameLabel = Il tuo nome
namePlaceholder = Come ti vedono gli altri del nucleo
tourIntro = Un minuto per orientarti.
getStarted = Inizia
tourRecipesTitle = Ricette
tourRecipesBody = Il ricettario condiviso. Sfoglia e cucina ciò che ogni nucleo ha aggiunto, e aggiungi le tue: importa da foto, pagine web o testo incollato invece di digitare tutto.
tourCollectionsTitle = Collezioni
tourCollectionsBody = Raggruppa le ricette come preferisci: i lunedì sera, un menù di festa, tutto da un libro. Le collezioni si possono condividere con altri nuclei tramite link.
tourCollectionsFallback = Sul telefono, Collezioni è in questo menu.
tourAssistantTitle = Assistente
tourAssistantBody = Una chat che aiuta con le parti noiose: trovare, importare e rielaborare ricette. Tutto ciò che propone resta in bozza finché non lo rivedi tu.
tourAssistantFallback = Sul telefono, l'Assistente è in questo menu.
tourPantryTitle = Dispensa
tourPantryBody = Cosa c'è in cucina. La dispensa alimenta il filtro "pronto da cucinare", dice alle ricette cosa hai già e ti avvisa prima che scada.
tourScanTitle = Scansiona
tourScanBody = Lo scanner di codici a barre. Inquadra la spesa mentre la disimballi e finisce in dispensa, con nome e formato già compilati.
tourPlanTitle = Piano
tourPlanBody = Cosa intendi cucinare. Pianificare un pasto mette gli ingredienti mancanti in lista della spesa; cucinarlo aggiorna la dispensa.
tourShoppingTitle = Lista della spesa
tourShoppingBody = Calcolata per te: ciò che il piano richiede e la dispensa non copre. Spunta gli articoli mentre li compri e vanno dritti in dispensa.
tourCatalogsTitle = Ingredienti, negozi e attrezzi
tourCatalogsBody = Cataloghi di riferimento condivisi. Segna quanto costano le cose e quali attrezzi hai; da lì arrivano i costi stimati e il filtro "pronto da cucinare".
tourCatalogsFallback = Sul telefono, questi cataloghi sono in questo menu.
tourDocsTitle = La guida
tourDocsBody = La documentazione completa di tutto quello che hai appena visto, quando ti servono i dettagli.
tourDocsFallback = Sul telefono, la guida è in questo menu.
tourHouseholdTitle = Il tuo nucleo
tourHouseholdBody = Le persone con cui cucini: membri, inviti e impostazioni. Tutto ciò che hai visto è condiviso con loro. Ora: crea un nucleo o unisciti con un invito.

[error]
notFoundTitle = Non abbiamo trovato quella pagina
notFoundBody = A questo indirizzo non c'è niente. Il link potrebbe essere vecchio, o la ricetta è stata rinominata o cancellata.
serverTitle = Qualcosa è andato storto
serverBody = La pagina non si è caricata. Spesso basta riprovare; se non basta, il problema è dalla nostra parte.
browseRecipes = Sfoglia le ricette
needHousehold = Unisciti a un nucleo o creane uno per farlo.
generic = Qualcosa è andato storto. Riprova.
noMatchQuery = Nessun risultato con quel nome.

[sudo]
banner = Sudo: stai agendo come {$name}. Le modifiche sono registrate a nome di {$admin}.
exit = Esci da sudo

[admin]
title = Amministrazione
pageUsers = Admin: Utenti
pageHouseholds = Admin: Nuclei
pageRecipes = Admin: Ricette
