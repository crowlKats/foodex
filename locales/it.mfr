[household]
settingsTitle = Impostazioni di {$name}
backToHousehold = Torna al nucleo
members = Membri ({$count :integer})
makeOwner = Rendi proprietario
makeOwnerConfirm = Rendere {$name} proprietario? I proprietari gestiscono membri, inviti e impostazioni, e così puoi lasciare il nucleo.
removeMember = Rimuovi membro
leave = Lascia il nucleo
leaveConfirm = Lasciare questo nucleo? Perderai ricette, dispensa e liste, e ti servirà un invito o un nuovo nucleo per continuare a usare Foodex.
leaveNeedOwner = Rendi proprietario un altro membro prima di uscire, oppure elimina il nucleo.
movingOutHint = Ti trasferisci? Rendi proprietario un altro membro, poi puoi uscire.
leavingHint = Te ne vai?
packBox = Prepara uno scatolone
packBoxRest = per portarti dietro le ricette.
inviteLink = Link di invito
inviteHelp = Condividi un link perché altri si uniscano. I link scadono dopo 7 giorni.
revoke = Revoca
generateInvite = Genera link di invito
householdName = Nome del nucleo
dangerZone = Zona pericolosa
deleteHousehold = Elimina nucleo
deleteConfirm = Eliminare questo nucleo? L'operazione non si può annullare.
getStarted = Inizia
getStartedBlurb = Crea un nuovo nucleo o unisciti a uno esistente per gestire ricette, attrezzi, negozi e la dispensa.
getStartedInviteOnly = Foodex è solo su invito. Unisciti a un nucleo con il codice o il link che hai ricevuto; se non ne hai uno, chiedi a un membro o a un operatore.
createHousehold = Crea nucleo
joinHousehold = Unisciti a un nucleo
inviteCode = Codice invito
inviteCodePlaceholder = Incolla il codice invito...
namePlaceholder = es. Famiglia Rossi
inviteCodeRequired = Il codice invito è obbligatorio
invalidInvite = Codice invito non valido o scaduto
inviteOnlyCreate = Foodex è solo su invito; i nuclei non si possono creare direttamente.
nameRequired = Il nome è obbligatorio
joinOrCreateTitle = Unisciti o crea un nucleo
owner = proprietario
member = membro
boxWillUnpack =
  .input {$count :integer}
  .match $count
  one {{Il tuo scatolone con {$count} ricetta verrà disimballato nel nucleo a cui ti unisci o che crei.}}
  * {{Il tuo scatolone con {$count} ricette verrà disimballato nel nucleo a cui ti unisci o che crei.}}
movingBoxLink = scatolone

[empty]
noTools = Nessun attrezzo ancora
noToolsMatch = Nessun attrezzo corrisponde a "{$query}"
noToolsBody = Gli attrezzi sono le tue pentole: una padella, una planetaria, un forno. Una ricetta può riferirne uno con le impostazioni ("180 °C", "fuoco medio") e una nota su come si usa.
noIngredients = Nessun ingrediente ancora
noIngredientsMatch = Nessun ingrediente corrisponde a "{$query}"
noIngredientsBody = Gli ingredienti sono il catalogo condiviso a cui puntano ricette, dispensa e lista della spesa. Collegare una riga a uno permette a Foodex di tracciare scorte, prezzi e sostituzioni.
noIngredientsMatchBody = Nel catalogo non c'è nulla con quel nome. Prova una ricerca più corta, o aggiungilo sotto.
noStores = Nessun negozio ancora
noStoresMatch = Nessun negozio corrisponde a "{$query}"
noStoresBody = I negozi sono i posti in cui compri. Registrarne uno permette di attaccare i prezzi agli ingredienti, da cui il totale in lista della spesa e il raggruppamento per negozio.
signInToAdd = Accedi per aggiungerne uno.
addFirstForm = Aggiungi il primo con il modulo in questa pagina.
addIngredientFirst = Usa il modulo Aggiungi ingrediente per crearne il primo.
noCollections = Nessuna collezione ancora
noCollectionsMatch = Nessuna collezione corrisponde a "{$query}"
noCollectionsBody = Raggruppa le ricette in un set per i feriali, un menù di festa, o qualunque altra cosa. Le collezioni si possono condividere con altri nuclei.
noConversations = Nessuna conversazione ancora
noConversationsMatch = Nessuna conversazione corrisponde a "{$query}"
noRecipes = Nessuna ricetta ancora
noRecipesBody = Scrivine una da zero, o importane una da un URL, una foto o un blocco di testo.
noRecipesMatch = Nessuna ricetta corrisponde a "{$query}"
noRecipesMatchBody = Prova una ricerca più corta.
noRecipesMatchBodyFilters = Prova una ricerca più corta, o cancella i filtri.
noRecipesFilters = Nessuna ricetta corrisponde a questi filtri
noRecipesFiltersBody = Niente nella raccolta soddisfa tutti i filtri che hai scelto.
nothingReady = Niente è pronto da cucinare
nothingReadyBody = "Pronto da cucinare" mostra solo le ricette già coperte dalla dispensa, e la dispensa è vuota.
stockPantry = Riempi la dispensa
showAllRecipes = Mostra tutte le ricette
clearAllFilters = Cancella tutti i filtri
newRecipe = Nuova ricetta
betweenHouseholds = Sei tra un nucleo e l'altro
betweenHouseholdsPacked = Unisciti o crea un nucleo e lo scatolone verrà disimballato lì.
betweenHouseholdsEmpty = Non c'è niente di imballato. Se hai lasciato un nucleo senza fare lo scatolone, chiedi a chi è rimasto di condividere ciò che ti serve.

