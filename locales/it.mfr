storesToolsDishes = Negozi / Attrezzi / Piatti
searchUsers = Cerca utenti...
noUsers = Nessun utente ancora
noUsersMatch = Nessun utente corrisponde a "{$query}"
noUsersBody = Gli account compaiono qui al primo accesso.
joined = iscritto il {$date}
sessionCount =
  .input {$count :integer}
  .match $count
  one {{{$count} sessione}}
  * {{{$count} sessioni}}
noHousehold = nessun nucleo
unitSystem = Sistema di unità
timezone = Fuso orario
language = Lingua
created = Creato
providers = Accesso
favorites = Preferiti
agentSessions = Chat assistente
aiTokens = Token IA
noNameUser = Utente
dangerZone = Zona pericolosa
noHouseholds = Nessun nucleo ancora
noHouseholdsMatch = Nessun nucleo corrisponde a "{$query}"
noHouseholdsBody = Un nucleo si crea in fase di onboarding, quindi ne compare uno per ogni account che ha finito quel passaggio.
noRecipes = Nessuna ricetta ancora
noRecipesMatch = Nessuna ricetta corrisponde a "{$query}"
noRecipesBody = Ogni ricetta della piattaforma compare in questo elenco, anche quelle private.
noAuditMatch = Nessuna voce corrisponde a questi filtri
noAuditMatchBody = Prova una ricerca più corta, un intervallo più ampio, o cancella i filtri.
noAudit = Nessuna operazione registrata ancora
noAuditBody = Creare, modificare o eliminare ricette, ingredienti, negozi, attrezzi, collezioni e nuclei finisce qui, così come le applicazioni dell'assistente e le azioni admin.
clearFilters = Cancella tutti i filtri
backToUsers = Torna agli utenti
backToHouseholds = Torna ai nuclei
allUsers = Tutti gli utenti
searchRecipes = Cerca ricette...
searchHouseholds = Cerca nuclei...
searchAudit = Cerca azioni, oggetti, autori, dettagli...
recipesModeration = {$count} in totale, private incluse. Eliminare da qui è per moderazione; non si può annullare.
inviteUser = Invita un nuovo utente
inviteUserHelp = Crea un nucleo vuoto e invia un link per email. Chi accetta ne diventa proprietario e sceglie il nome quando entra.
invite = Invita
pendingInvites = Inviti in sospeso ({$count})
noOutstandingInvites = Nessun invito in sospeso.
revokeInviteConfirm = Revocare l'invito per {$email}? Anche il nucleo vuoto viene rimosso.
thisAddress = questo indirizzo
account = Account
activity = Attività
userId = ID utente
emailOnly = Solo email
none = nessuno

