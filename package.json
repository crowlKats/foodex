{
  "name": "foodex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "bash scripts/dev-full.sh",
    "build": "vite build",
    "preview": "vite preview",
    "start": "deno run -A --env-file=.env .output/server/index.mjs",
    "test": "deno test -A --no-check",
    "typecheck": "deno check routes islands components lib db entry.server.ts entry.client.ts utils.ts",
    "check": "deno fmt --check routes islands components lib db examples *.ts && deno lint routes islands components lib db examples *.ts && vite build && deno task typecheck",
    "migrate": "deno run -A --env-file=.env db/migrate.ts",
    "examples": "deno run -A --env-file=.env examples/import.ts"
  },
  "dependencies": {
    "fresh": "npm:@frsh/fresh@latest",
    "@tabler/icons-preact": "^3.45.0",
    "@luca/highlightable-textarea": "jsr:^0.1.1",
    "@std/assert": "jsr:^1.0.19",
    "preact": "^10.29.7",
    "@preact/signals": "^2.10.0",
    "vite": "^8.1.5",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "pg": "^8.22.0",
    "marked": "^15.0.12",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@anthropic-ai/sdk": "^0.105.0",
    "nodemailer": "^6.10.1",
    "barcode-detector": "^3.2.1",
    "zxing-wasm": "^3.1.2",
    "zod": "^3.25.76",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/nodemailer": "^6.4.24",
    "@prefresh/core": "^1.5.10",
    "@prefresh/utils": "^1.2.1"
  },
  "overrides": {
    "lightningcss": "^1.33.0"
  }
}
